{
  "expo": {
    "name": "TraKKiT",
    "slug": "trakkit-mobile-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trakkit",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trakkit.mobile",
      "backgroundColor": "#FFFFFF",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TraKKiT needs your location to verify check-ins and record field activity.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "TraKKiT tracks your location during active shifts for supervisor visibility.",
        "NSCameraUsageDescription": "TraKKiT needs camera access for attendance selfies and field photos.",
        "NSMicrophoneUsageDescription": "TraKKiT needs microphone access to record interaction audio."
      }
    },
    "android": {
      "package": "com.trakkit.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 220
        }
      ],
      "expo-system-ui",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow TraKKiT to use your location during active shifts.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TraKKiT to access your camera for attendance selfies."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow TraKKiT to record interaction audio."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keepattributes SourceFile,LineNumberTable\n-renamesourcefileattribute SourceFile"
          }
        }
      ],
      "./plugins/withAndroidR8.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b6a223dc-606b-4097-89d3-232941bc2cd3"
      }
    },
    "owner": "gm176"
  }
}
